# Demo pública (seed em memória). Desligue para persistir de verdade.
NEXT_PUBLIC_DEMO=true

# Protege POST /api/ingest. No chatbot: LOGS_INGEST_SECRET com o mesmo valor.
INGEST_SECRET=dev-ingest-secret

# Painel (ignorado quando NEXT_PUBLIC_DEMO=true)
DASHBOARD_PASSWORD=demo
SESSION_SECRET=troque-esta-chave

# Postgres (Neon, Docker local na porta 5435, etc.)
# DATABASE_URL=postgresql://chatobs:chatobs@localhost:5435/chatobs
# DATABASE_SSL=true

# Grafana Cloud Loki (opcional)
# LOKI_PUSH_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
# LOKI_USER=123456
# LOKI_TOKEN=glc_xxx
# LOKI_ENV=production
